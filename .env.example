# =============================================================================
# Nitshio — secretos y variables de entorno
# =============================================================================
# Copia este archivo a `.env` y rellena solo lo que uses.
# `.env` está en .gitignore: nunca lo subas a un repositorio.
# =============================================================================

# --- Ollama ---------------------------------------------------------------
# Si usas otra máquina o un proxy, cambia también config/config.yaml.
OLLAMA_HOST=http://localhost:11434

# --- Fish Audio (TTS opcional en la nube) ---------------------------------
# https://fish.audio/  ->  API key
FISH_API_KEY=

# --- Google Custom Search (búsqueda opcional con API) ---------------------
# Si están vacías, Nitshio usa DuckDuckGo y abre Google en el navegador.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Discord (modo llamada opcional) --------------------------------------
# Requiere un bot con permisos de voz y el intent de mensajes.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# --- Hugging Face (solo para el notebook de fine-tune en la nube) ---------
HF_TOKEN=

# --- Logging --------------------------------------------------------------
NITSHIO_LOG_LEVEL=INFO
